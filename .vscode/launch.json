{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Select Barry.",
            "type": "node",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "runtimeExecutable": "homey",
            "args": ["select", "-n", "Homey van Barry"]
        },
        {
            "name": "Select Homey Pro Early 2023",
            "type": "node",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "runtimeExecutable": "homey",
            "args": ["select", "-n", "Danee's Homey Pro"]
        },
        {
            "name": "Launch app on van Barry",
            "type": "node",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "runtimeExecutable": "homey",
            "args": ["app", "run"],
            "outputCapture": "std",
            "serverReadyAction": {
                "pattern": "Debugger listening on",
                "action": "startDebugging",
                "name": "Attach to van Barry"
            }
        },
        {
            "name": "Attach to van Barry",
            "type": "node",
            "request": "attach",
            "address": "192.168.178.204",
            "port": 9222,
            "localRoot": "${workspaceFolder}",
            "remoteRoot": "/"
        },
        {
            "name": "Launch app on Homey Pro Early 2023",
            "type": "node",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "runtimeExecutable": "homey",
            "args": ["app", "run", "--remote"],
            "outputCapture": "std",
            "serverReadyAction": {
                "pattern": "Debugger listening on",
                "action": "startDebugging",
                "name": "Attach to Homey Pro Early 2023"
            }
        },
        {
            "name": "Attach to Homey Pro Early 2023",
            "type": "node",
            "request": "attach",
            "address": "192.168.178.204",
            "port": 9222,
            "localRoot": "${workspaceFolder}",
            "remoteRoot": "/app/"
        }
    ]
}
